# shellcheck shell=bash
# shellcheck disable=SC2034
# Versiones del entorno. Cambiar un valor aca lo cambia en todas las distros.

# Node.js (via nvm) y pnpm (via corepack).
NVM_VERSION="v0.40.3"
NODE_VERSION="24"

# Java (via SDKMAN). Se instala la ultima build de cada version mayor del
# proveedor indicado ("amzn" = Amazon Corretto). Gradle y Quarkus siempre en
# su ultima version.
JAVA_VENDOR="amzn"
JAVA_MAJORS="21 25"
JAVA_DEFAULT_MAJOR="21"

# .NET SDK. Se usa en packages.txt como ${DOTNET_CHANNEL}.
DOTNET_CHANNEL="10.0"
